# Reference only; generate local files with npm run local:configure.
# Never put actual tokens or passwords in a tracked environment file.
ELM_PROFILE=shared
ELM_ORGANIZATION_ID=REPLACE_WITH_ORGANIZATION_UUID
ELM_ISSUER=https://sso.example.invalid/realms/engineering-learning
ELM_MCP_RESOURCE=https://learning-mcp.example.invalid/mcp
ELM_REVIEW_URL=https://learning-review.example.invalid
ELM_ALLOWED_CLIENT_IDS=REPLACE_WITH_REVIEWED_NATIVE_CLIENT_IDS
ELM_ALLOWED_HOSTS=learning-mcp.example.invalid
ELM_ALLOWED_ORIGINS=https://learning-review.example.invalid
ELM_GITLEAKS_BIN=/usr/local/bin/gitleaks
ELM_GITLEAKS_CONFIG=/app/config/gitleaks.toml
# Inject only this process's database URL at runtime:
# MCP: ELM_MCP_DATABASE_URL; Review: ELM_REVIEW_DATABASE_URL
# Review only: ELM_REVIEW_CLIENT_ID and ELM_REVIEW_CLIENT_SECRET
# Never enable these attestations without the corresponding deployment review:
ELM_APPROVED_SHARED_CONFIG=false
ELM_TLS_TERMINATED=false
ELM_STORAGE_ENCRYPTION_CONFIRMED=false
ELM_RETENTION_APPROVED=false
